# Copy to .env.production and fill in once the nuwebspace URL is known (Phase 6b).
# VITE_BASE: public path the frontend is served from. Must start and end with "/".
#   Root of a domain: /      Sub-folder: /~username/riverready/
VITE_BASE=/
# VITE_API_BASE: where the PHP API lives (relative path keeps it same-origin, no CORS).
VITE_API_BASE=/api
